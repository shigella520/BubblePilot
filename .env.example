# Copy to a local, ignored .env file and replace every CHANGE_ME value.
NODE_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
# Use dev only for validation. Pin X.Y.Z or sha-<commit> for stable deployments.
BUBBLEPILOT_IMAGE=ghcr.io/shigella520/bubblepilot:dev
POSTGRES_DB=bubblepilot
POSTGRES_USER=bubblepilot
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql://bubblepilot:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/bubblepilot
API_ACCESS_TOKEN=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Used to encrypt runtime-managed BlueBubbles credentials. Keep stable across
# redeployments; if omitted, API_ACCESS_TOKEN is used as a compatibility fallback.
SETTINGS_ENCRYPTION_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SESSION_COOKIE_SECURE=auto
BLUEBUBBLES_WEBHOOK_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MONITORED_CHAT_IDS=
WEBHOOK_BODY_LIMIT_BYTES=1048576
RATE_LIMIT_WINDOW_SECONDS=60
ADMIN_RATE_LIMIT_MAX=600
WEBHOOK_RATE_LIMIT_MAX=300
WORKFLOW_MAX_CONCURRENCY=4
WORKFLOW_QUEUE_CAPACITY=64
WORKFLOW_QUEUE_WAIT_MS=30000
STALE_RETRY_SECONDS=300
LOG_LEVEL=info
BLUEBUBBLES_SERVER_URL=CHANGE_ME
BLUEBUBBLES_ACCESS_TOKEN=CHANGE_ME
BLUEBUBBLES_SEND_METHOD=private-api
BLUEBUBBLES_REQUEST_TIMEOUT_MS=30000
ENABLE_WEB_SEARCH=false
SEARXNG_BASE_URL=http://searxng:8080
WEB_SEARCH_TIMEOUT_MS=8000
WEB_SEARCH_MAX_RESULTS=5
SEARXNG_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Generate with pnpm auth:hash and keep the single quotes so '$' stays literal.
APP_LOGIN_PASSWORD_HASH='CHANGE_ME_WITH_SCRYPT_HASH'
SENSITIVE_OPERATION_PASSWORD_HASH='CHANGE_ME_WITH_A_DIFFERENT_SCRYPT_HASH'
ADMIN_SESSION_TTL_SECONDS=43200
SENSITIVE_OPERATION_TTL_SECONDS=300
# AI Provider endpoints, models and API Keys are managed through the protected
# Web UI/API and encrypted in PostgreSQL.
# Redact archived message bodies and attachment metadata after this many days.
# Set to 0 only when indefinite retention is an explicit, accepted decision.
MESSAGE_RETENTION_DAYS=90
