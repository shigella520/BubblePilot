# Copy to a local, ignored .env file and replace every CHANGE_ME value.
NODE_ENV=development
APP_BASE_URL=http://localhost:8080
APP_HOST=0.0.0.0
APP_PORT=8080
# Use dev only for validation. Pin X.Y.Z or sha-<commit> for stable deployments.
BUBBLEPILOT_IMAGE=ghcr.io/shigella520/bubblepilot:dev
POSTGRES_DB=bubblepilot
POSTGRES_USER=bubblepilot
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql://bubblepilot:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/bubblepilot
API_ACCESS_TOKEN=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BLUEBUBBLES_WEBHOOK_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MONITORED_CHAT_IDS=
WEBHOOK_BODY_LIMIT_BYTES=1048576
LOG_LEVEL=info
BLUEBUBBLES_SERVER_URL=CHANGE_ME
BLUEBUBBLES_ACCESS_TOKEN=CHANGE_ME
APP_LOGIN_PASSWORD_HASH=CHANGE_ME
SENSITIVE_OPERATION_PASSWORD_HASH=CHANGE_ME
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=CHANGE_ME
AI_PROVIDER_MODEL=CHANGE_ME
MESSAGE_RETENTION_DAYS=90
