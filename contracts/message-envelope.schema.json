{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bubblepilot.local/contracts/message-envelope.schema.json",
  "title": "BubblePilot MessageEnvelope",
  "type": "object",
  "required": [
    "schemaVersion",
    "eventId",
    "correlationId",
    "provider",
    "chat",
    "message",
    "metadata"
  ],
  "properties": {
    "schemaVersion": { "const": "3" },
    "eventId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "format": "uuid" },
    "provider": { "const": "bluebubbles" },
    "chat": {
      "type": "object",
      "required": ["providerChatId", "type", "displayName"],
      "properties": {
        "providerChatId": { "type": "string", "minLength": 1 },
        "type": { "enum": ["direct", "group", "unknown"] },
        "displayName": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "required": [
        "providerMessageId",
        "senderId",
        "sentAt",
        "text",
        "contentType",
        "isFromMe",
        "attachments",
        "linkPreview",
        "contentHash"
      ],
      "properties": {
        "providerMessageId": { "type": "string", "minLength": 1 },
        "senderId": { "type": ["string", "null"] },
        "sentAt": { "type": "string", "format": "date-time" },
        "text": { "type": ["string", "null"] },
        "contentType": { "enum": ["text", "attachment", "mixed", "unknown"] },
        "isFromMe": { "type": "boolean" },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "providerAttachmentId",
              "mimeType",
              "fileName",
              "sizeBytes"
            ],
            "properties": {
              "providerAttachmentId": { "type": "string", "minLength": 1 },
              "mimeType": { "type": ["string", "null"] },
              "fileName": { "type": ["string", "null"] },
              "sizeBytes": { "type": ["integer", "null"], "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "linkPreview": {
          "type": "object",
          "required": ["status", "errorCode", "items"],
          "properties": {
            "status": {
              "enum": [
                "not-requested",
                "pending",
                "available",
                "unavailable",
                "failed",
                "redacted"
              ]
            },
            "errorCode": { "type": ["string", "null"] },
            "items": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "required": [
                  "source",
                  "url",
                  "originalUrl",
                  "title",
                  "summary",
                  "siteName",
                  "imageAvailable",
                  "imageUrl",
                  "imageSource",
                  "iconAvailable"
                ],
                "properties": {
                  "source": { "enum": ["bluebubbles", "open-graph"] },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2048
                  },
                  "originalUrl": {
                    "type": ["string", "null"],
                    "format": "uri",
                    "maxLength": 2048
                  },
                  "title": { "type": ["string", "null"], "maxLength": 500 },
                  "summary": { "type": ["string", "null"], "maxLength": 2000 },
                  "siteName": { "type": ["string", "null"], "maxLength": 200 },
                  "imageAvailable": { "type": "boolean" },
                  "imageUrl": {
                    "type": ["string", "null"],
                    "format": "uri",
                    "maxLength": 2048
                  },
                  "imageSource": {
                    "enum": ["bluebubbles", "open-graph", null]
                  },
                  "iconAvailable": { "type": "boolean" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": ["isReplay", "payloadHash", "eventType", "adapterVersion"],
      "properties": {
        "isReplay": { "type": "boolean" },
        "payloadHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "eventType": { "type": "string" },
        "adapterVersion": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
