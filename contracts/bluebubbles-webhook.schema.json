{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bubblepilot.local/contracts/bluebubbles-webhook.schema.json",
  "title": "BlueBubbles message and content-update webhooks",
  "oneOf": [
    {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": {
          "const": "new-message"
        },
        "data": {
          "type": "object",
          "required": ["guid", "dateCreated", "isFromMe", "chats"],
          "properties": {
            "guid": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": ["string", "null"]
            },
            "dateCreated": {
              "type": "integer",
              "minimum": 0
            },
            "isFromMe": {
              "type": "boolean"
            },
            "hasPayloadData": {
              "type": "boolean"
            },
            "handle": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": ["address"],
                  "properties": {
                    "address": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": true
                }
              ]
            },
            "chats": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["guid"],
                "properties": {
                  "guid": {
                    "type": "string",
                    "minLength": 1
                  },
                  "style": {
                    "type": "integer"
                  },
                  "displayName": {
                    "type": ["string", "null"]
                  },
                  "chatIdentifier": {
                    "type": ["string", "null"]
                  }
                },
                "additionalProperties": true
              }
            },
            "attachments": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["guid"],
                "properties": {
                  "guid": {
                    "type": "string",
                    "minLength": 1
                  },
                  "mimeType": {
                    "type": ["string", "null"]
                  },
                  "transferName": {
                    "type": ["string", "null"]
                  },
                  "totalBytes": {
                    "type": ["integer", "null"],
                    "minimum": 0
                  }
                },
                "additionalProperties": true
              },
              "default": []
            },
            "threadOriginatorGuid": {
              "type": ["string", "null"],
              "maxLength": 1024
            },
            "threadOriginatorPart": {
              "type": ["string", "null"],
              "maxLength": 256
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": {
          "const": "updated-message"
        },
        "data": {
          "type": "object",
          "required": ["guid"],
          "properties": {
            "guid": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "dateEdited": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "dateRetracted": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "partCount": {
              "type": "integer",
              "minimum": 0
            },
            "text": {
              "type": ["string", "null"]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  ]
}
