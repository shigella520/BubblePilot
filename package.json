{
  "name": "bubblepilot",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "A self-hosted automation, archiving, and AI bot platform for BlueBubbles.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "auth:hash": "tsx app/hash-password.ts",
    "build": "pnpm build:server && pnpm build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "pnpm --dir apps/web build",
    "contracts:check": "node scripts/check-openapi-routes.mjs && node scripts/check-config-contract.mjs",
    "contracts:workflow-schema": "pnpm build:server && node scripts/generate-workflow-schema.mjs",
    "db:migrate": "tsx app/migrate.ts",
    "db:migrate:local": "tsx --env-file=.env.local app/migrate.ts",
    "dev": "tsx watch app/main.ts",
    "dev:local": "tsx --env-file=.env.local watch app/main.ts",
    "dev:web": "pnpm --dir apps/web dev",
    "docs:check": "node scripts/check-markdown-links.mjs",
    "format": "prettier --check app modules tests contracts apps/web/src apps/web/*.json apps/web/*.ts apps/web/*.html scripts/*.mjs *.json *.js *.ts *.yaml",
    "format:write": "prettier --write app modules tests contracts apps/web/src apps/web/*.json apps/web/*.ts apps/web/*.html scripts/*.mjs *.json *.js *.ts *.yaml",
    "lint": "eslint .",
    "ops:check": "sh -n scripts/*.sh && node scripts/check-ops-contract.mjs",
    "security:check": "pnpm audit --prod --audit-level=moderate",
    "start": "node dist/app/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm ops:check && pnpm contracts:check && pnpm docs:check && pnpm build"
  },
  "dependencies": {
    "@fastify/static": "10.1.2",
    "cheerio": "1.1.2",
    "fastify": "^5.12.1",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.4.1",
    "yaml": "^2.9.0"
  }
}
