# Resolve and pre-pull a Python 3.12 digest for your architecture before deployment.
SANDBOX_IMAGE=python:3.12-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704
OPENSANDBOX_URL=http://host.docker.internal:18090
ADAPTER_INSTANCE_ID=bubblepilot-sandbox
MAX_CONCURRENT_SANDBOXES=1
MAX_MCP_SESSIONS=64
SANDBOX_TTL_SECONDS=600
SANDBOX_MEMORY_MIB=512
MCP_BIND_ADDRESS=127.0.0.1
MCP_PORT=18091
