{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true
  },
  "include": [
    "../../modules/ai/execution-policy.ts",
    "../../modules/workflow/idle-policy.ts",
    "../../modules/workflow/idle-defaults.ts",
    "src/**/*.ts",
    "src/**/*.vue",
    "vite.config.ts"
  ]
}
